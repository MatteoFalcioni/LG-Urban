{
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "ListBucketOnPrefixes",
        "Effect": "Allow",
        "Principal": {
          "AWS": "arn:aws:iam::511582926637:root"
        },
        "Action": ["s3:ListBucket"],
        "Resource": "arn:aws:s3:::urbia-prod",
        "Condition": {
          "StringLike": {
            "s3:prefix": ["input/*", "output/*", "tests/*"]
          }
        }
      },
      {
        "Sid": "ReadInputDatasets",
        "Effect": "Allow",
        "Principal": {
          "AWS": "arn:aws:iam::511582926637:root"
        },
        "Action": ["s3:GetObject"],
        "Resource": "arn:aws:s3:::urbia-prod/input/*"
      },
      {
        "Sid": "WriteInputDatasets",
        "Effect": "Allow",
        "Principal": {
          "AWS": "arn:aws:iam::511582926637:root"
        },
        "Action": ["s3:PutObject", "s3:DeleteObject"],
        "Resource": "arn:aws:s3:::urbia-prod/input/datasets/*"
      },
      {
        "Sid": "RWOutput",
        "Effect": "Allow",
        "Principal": {
          "AWS": "arn:aws:iam::511582926637:root"
        },
        "Action": ["s3:PutObject", "s3:GetObject"],
        "Resource": "arn:aws:s3:::urbia-prod/output/*"
      },
      {
        "Sid": "RWDTests",
        "Effect": "Allow",
        "Principal": {
          "AWS": "arn:aws:iam::511582926637:root"
        },
        "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
        "Resource": "arn:aws:s3:::urbia-prod/tests/*"
      }
    ]
  }
