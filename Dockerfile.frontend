# syntax=docker/dockerfile:1
# check=skip=SecretsUsedInArgOrEnv
# Dockerfile.frontend
# Frontend React app with Vite

FROM node:20-alpine AS builder

WORKDIR /app

# Accept build arguments. Vite embeds VITE_* values into the static bundle.
# Clerk publishable keys are intentionally browser-visible.
ARG VITE_API_URL
ARG VITE_CLERK_PUBLISHABLE_KEY
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_CLERK_PUBLISHABLE_KEY=$VITE_CLERK_PUBLISHABLE_KEY

# Copy package files
COPY frontend/package*.json ./

# Install dependencies
RUN npm ci

# Copy frontend source
COPY frontend/ .

# Build the app
RUN npm run build

# Production stage with nginx
FROM nginx:alpine

# Install gettext for envsubst
RUN apk add --no-cache gettext

# Copy built assets from builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx configuration template
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf.template

# Copy and make entrypoint script executable
COPY frontend/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

# Railway injects PORT at runtime. The entrypoint falls back to 8080 for local runs.
EXPOSE 8080

ENTRYPOINT ["/docker-entrypoint.sh"]
